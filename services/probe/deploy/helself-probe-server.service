[Unit]
Description=Helself Probe Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helself-probe
Group=helself-probe
ExecStart=/usr/local/bin/helself-probe server --listen 0.0.0.0:8008 --data /var/lib/helself-probe/probe.db --admin-token-file /etc/helself-probe/admin-token --tls-cert /etc/helself-probe/tls.crt --tls-key /etc/helself-probe/tls.key
StateDirectory=helself-probe
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
